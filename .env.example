# Public base URL of the site. Used for metadata, canonical URLs, sitemap and robots.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form (src/app/api/contact/route.ts) ---

# API key for the transactional email provider (default implementation: Resend).
# Leave empty in development: submissions are validated and logged instead of sent.
RESEND_API_KEY=

# Inbox that receives contact form submissions.
CONTACT_RECIPIENT_EMAIL=hello@setupfx.com

# Verified sender address the notification is sent from.
CONTACT_SENDER_EMAIL=website@setupfx.com
